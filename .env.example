# Copy to .env and fill in. NEVER commit .env.
#
# Django secret. Generate one:
#   python3 -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=

# GitHub account that owns the rdgen fork, and a PAT with `repo` +
# `workflow` scope so rdgen can dispatch the build workflows.
GHUSER=
GHBEARER=

# Public URL rdgen is reached at, including scheme. No trailing slash, no port.
GENURL=https://rdgen.example.com

# Password applied to generated client zips.
ZIP_PASSWORD=

# Shared secret enabling the self-hosted build workflow. Leave empty to disable.
SH_SECRET=
